{
  "module": {
    "name": "musichomesample",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "MusichomeAbility",
    "deviceTypes": [
      "phone",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    // 应用级沉浸光感开关（官方文档：普通组件要用 systemMaterial，必须先把它设为 enable；
    // default 时组件级 systemMaterial 不生效 —— 这就是之前「材质不渲染」的真因）。
    "metadata": [
      {
        "name": "ohos.arkui.UIMaterial.state",
        "value": "enable"
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET",
        "reason": "$string:reason_internet"
      },
      {
        "name": "ohos.permission.DISTRIBUTED_DATASYNC",
        "reason": "$string:reason_distributed",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.VIBRATE"
      },
      {
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING",
        "reason": "$string:reason_background",
        "usedScene": {
          "abilities": [
            "MusichomeAbility"
          ],
          "when": "always"
        }
      }
    ],
    "abilities": [
      {
        "name": "MusichomeAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:ic_music_icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "minWindowHeight": 480,
        "minWindowWidth": 360,
        "orientation": "follow_desktop",
        "backgroundModes": [
          "audioPlayback"
        ],
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ]
      }
    ],

    "extensionAbilities": [
      {
        "name": "MusichomeBackupAbility",
        "srcEntry": "./ets/phonebackupextability/PhoneBackupExtAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ],
      },
      {
        "name": "WidgetFormAbility",
        "srcEntry": "./ets/form/WidgetFormAbility.ets",
        "description": "$string:widget_music_desc",
        "label": "$string:widget_music_display_name",
        "type": "form",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.form",
            "resource": "$profile:form_config"
          }
        ]
      }
    ]
  }
}
