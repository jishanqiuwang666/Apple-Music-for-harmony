# ── 构建产物（不要提交）──────────────────────────────
/build/
/products/*/build/
/features/*/build/
/common/*/build/
*.hap
# 例外：分发用的预编译包要进仓库
!/dist/*.hap
*.hsp
*.har
*.app
/.hvigor/
/.idea/
/.cxx/
/oh_modules/
**/oh_modules/
/.workbuddy/

# ── 签名材料（只能在你自己机器上，绝不能进仓库）──────────
/build-profile.signing.local.json5
*.p12
*.cer
*.p7b
*.csr
*.keystore
/local.properties

# ── 本机私有内容 ────────────────────────────────────
/AGENTS.md
/backups/
/研究归档/
/dsh-reminder-app*/
=0
.DS_Store
*.tar.gz

# ── 一次性调试脚本 / 抓包 / 日志（含本机绝对路径与 cookie）──
/tools/apple-music/*.py
/tools/apple-music/*.sh.bak*
/tools/apple-music/*.log
/tools/apple-music/*.txt
/tools/apple-music/*.json
/tools/apple-music/venv/
/tools/apple-music/app/

# ── 本机凭据（真实值只留在你的机器上；仓库里只有 *.example.ets 模板）──
common/musicbasic/src/main/ets/apple/AiKeyLocal.ets
common/musicbasic/src/main/ets/apple/widevine/WvdLocal.ets
*.example-hidden

# ── 别的项目的文档（dsh-reminder），不属于本仓库 ──
/docs/superpowers/

# ── macOS 资源分支垃圾（._xxx）──────────────────────────
._*
**/._*

# ── hvigor 自动生成的版本信息文件（每次构建都会重写）────────
**/BuildProfile.ets
