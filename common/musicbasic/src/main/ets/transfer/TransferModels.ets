/**
 * Message models exchanged over the distributed KV channel between the phone
 * (sender) and the watch (receiver). All payloads are JSON-serialized strings.
 */

/** Pull request: watch asks the phone to stage songs into the distributed dir. */
export class TransferRequest {
  /** Monotonic request id generated by the receiver. */
  public requestId: number = 0;
  /** Library song ids to pull. */
  public songIds: number[] = [];
  /** Epoch ms of the request (informational). */
  public timestamp: number = 0;
}

/** Staged notification: phone finished copying songs into the distributed dir. */
export class TransferReady {
  /** Matches {@link TransferRequest.requestId}. */
  public requestId: number = 0;
}

/** Completion report: receiver finished pulling (or failed part of) the batch. */
export class TransferDone {
  /** Matches {@link TransferRequest.requestId}. */
  public requestId: number = 0;
  /** Number of songs pulled successfully. */
  public successCount: number = 0;
  /** Song ids that failed to pull. */
  public failedIds: number[] = [];
}

/** Lightweight song entry in the library snapshot pushed by the phone. */
export class MetaSong {
  public id: number = 0;
  public title: string = '';
  public artist: string = '';
  public album: string = '';
  public duration: number = 0;
  /** Sandbox cover path on the phone (not reachable from the watch; UI-only). */
  public coverPath: string = '';
  public trackNumber: number = 0;
}

/** Library snapshot: the phone's full music library for the watch browser. */
export class LibraryMeta {
  /** Incremented by the sender on every publish. */
  public version: number = 0;
  public songs: MetaSong[] = [];
}
